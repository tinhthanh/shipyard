{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/berth-cli",
      "binaries/berth-agent"
    ],
    "shortDescription": "Agents on your boxes",
    "longDescription": "Run coding agents on your own boxes and watch them from here. This is the Windows app's alpha.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "binaries/berthd-linux-amd64": "berthd-linux-amd64",
      "binaries/berthd-linux-arm64": "berthd-linux-arm64"
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
